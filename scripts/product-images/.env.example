# Copy this file to .env in the same folder and fill in the values.
# .env is git-ignored. Never commit real keys.

# --- Bulkskart Supabase (self-hosted on the AWS VM) -------------------------
SUPABASE_URL=https://www.bulkskart.com
# Public key the website already uses (safe to share). Used to read products and verify updates.
SUPABASE_ANON_KEY=
# REQUIRED for 'apply': uploads images to storage and updates products.
# On the VM it is SERVICE_ROLE_KEY in /opt/bulkskart/stack/.env. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# --- Image search ------------------------------------------------------------
# openverse  = Openverse API (Flickr, Wikimedia Commons and more), filtered to licences that
#              allow commercial use and modification. Works without a key (low rate limit).
# google_cse = Google Programmable Search, ONLY if your Google account still has access
#              (closed to new customers; whole-web search ends 1 January 2027).
IMAGE_SEARCH_PROVIDER=openverse

# Optional: raises the Openverse rate limit. Register at
# https://api.openverse.org/v1/#tag/auth/operation/register (client credentials).
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=

# Only for IMAGE_SEARCH_PROVIDER=google_cse
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
